# PYTHON ENVIRONMENT & CACHE (For your src/ files)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# ==========================================
# EXCLUSIONS / SPECIAL RULES
# ==========================================
# If you want to keep final PDFs inside a specific "releases" folder, 
# uncomment the next line to ignore all other PDFs in the source folder:
# *.pdf